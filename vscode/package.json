{
  "name": "personal-assistant",
  "displayName": "Personal Assistant",
  "description": "AI-powered development assistant integrated into VS Code",
  "version": "1.0.0",
  "publisher": "personal-assistant",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Machine Learning", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "personal-assistant.runAgent", "title": "Personal Assistant: Run Agent" },
      { "command": "personal-assistant.openChat", "title": "Personal Assistant: Open Chat" },
      { "command": "personal-assistant.generateRepoMap", "title": "Personal Assistant: Generate Repo Map" },
      { "command": "personal-assistant.showPlugins", "title": "Personal Assistant: Show Plugins" },
      { "command": "personal-assistant.enableMCP", "title": "Personal Assistant: Enable MCP Service" },
      { "command": "personal-assistant.gitCheckpoint", "title": "Personal Assistant: Git Checkpoint" },
      { "command": "personal-assistant.gitUndo", "title": "Personal Assistant: Git Undo" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "personal-assistant", "title": "Personal Assistant", "icon": "resources/icon.svg" }]
    },
    "views": {
      "personal-assistant": [
        { "id": "personal-assistant.chat", "name": "Chat", "type": "webview" },
        { "id": "personal-assistant.plugins", "name": "Plugins" },
        { "id": "personal-assistant.mcp", "name": "MCP Services" }
      ]
    },
    "menus": {
      "editor/context": [
        { "command": "personal-assistant.runAgent", "when": "editorHasSelection", "group": "personal-assistant" }
      ]
    },
    "configuration": {
      "title": "Personal Assistant",
      "properties": {
        "personal-assistant.cliPath": { "type": "string", "default": "", "description": "Path to personal-assistant CLI (auto-detected if empty)" },
        "personal-assistant.defaultModel": { "type": "string", "default": "claude-3-5-sonnet-20241022", "description": "Default AI model" },
        "personal-assistant.autoCheckpoint": { "type": "boolean", "default": true, "description": "Auto-create git checkpoints before changes" },
        "personal-assistant.showRepoMap": { "type": "boolean", "default": true, "description": "Show repo map on startup" }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}