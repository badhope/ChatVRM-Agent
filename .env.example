# =============================================================================
# ChatVRM Agent — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your secrets.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# Anything in the in-app Settings panel takes precedence at runtime.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI (required for /api/chat)
# -----------------------------------------------------------------------------
# Used by `POST /api/chat` when the client does not provide its own key in the
# request body. Get one at https://platform.openai.com/api-keys
OPEN_AI_KEY=

# -----------------------------------------------------------------------------
# Optional knobs
# -----------------------------------------------------------------------------
# Override the default chat model. Defaults to "gpt-4o-mini" inside the
# /api/chat handler. Examples: gpt-4o, gpt-4-turbo, gpt-3.5-turbo.
# OPEN_AI_MODEL=gpt-4o-mini

# Koeiromap TTS base URL. The default points at the public Koemotion endpoint.
# Change this if you self-host Koeiromap.
# KOEIROMAP_BASE_URL=https://api.rinna.co.jp

# Port for the Next.js dev / start server.
# PORT=3000
