{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/monitoring/index.ts",
    "src/browser/agent.ts",
    "src/channels/index.ts",
    "src/skills/index.ts",
    "src/multi-agent/scheduler.ts",
    "src/scheduler/index.ts",
