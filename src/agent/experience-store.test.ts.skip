/**
 * ExperienceRepository 单元测试
 * 使用新的 DDD 架构
 */

import { describe, it, expect, beforeEach, afterEach } from 'vitest';
import * as fs from 'fs/promises';
import * as path from 'path';
import * as os from 'os';
import { JsonExperienceRepository } from './infrastructure/repositories/experience.repository.js';
import type { Experience } from './domain/models/experience.model.js';

// 使用临时目录进行测试
let tempDir: string;
let repository: JsonExperienceRepository;

function createTestExperience(overrides: Partial<Experience> = {}): Experience {
  return {
    id: `exp-test-${Date.now()}-${Math.random().toString(36).substring(2, 9)}`,
    timestamp: new Date().toISOString(),
    taskType: 'bug-fix',
    taskDescription: '修复登录页面的表单验证问题',
    decisions: [
      {
        context: '需要选择工具来读取文件',
        chosen: 'read_file',
        outcome: 'success',
        confidence: 0.9,
        reasoning: '使用 read_file 工具读取源代码文件',
      },
    ],
    lessons: ['✅ 成功经验: 使用 read_file 先读取文件再修改', '❌ 改进方向: 修改前应该先备份文件'],
    improvements: ['建议改进: 修改配置文件前总是先备份'],
    patterns: ['登录页面表单验证失败', 'read_file 工具使用成功'],
    emotionalTone: 'confident',
    ...overrides,
  };
}

beforeEach(async () => {
  tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'experience-repo-test-'));
  repository = new JsonExperienceRepository(tempDir);
});

afterEach(async () => {
  // 清理临时目录
  try {
    await fs.rm(tempDir, { recursive: true, force: true });
  } catch {
    // 忽略清理失败
  }
});

describe('JsonExperienceRepository', () => {
  describe('addExperience', () => {
    it('应该正确添加一条经验', async () => {
      const exp = createTestExperience();
      await repository.addExperience(exp);
      await repository.loadAll();

      expect(await repository.getExperienceCount()).toBe(1);
    });

    it('应该支持添加多条经验', async () => {
      await repository.addExperience(createTestExperience());
      await repository.addExperience(createTestExperience());
      await repository.addExperience(createTestExperience());
      await repository.loadAll();

      expect(await repository.getExperienceCount()).toBe(3);
    });

    it('添加经验后应该自动持久化到磁盘', async () => {
      const exp = createTestExperience();
      await repository.addExperience(exp);
      await repository.saveAll();

      // 创建新的 repository 实例，从磁盘加载
      const newRepo = new JsonExperienceRepository(tempDir);
      await newRepo.loadAll();
      expect(await newRepo.getExperienceCount()).toBe(1);
    });

    it('超过 200 条经验时应该自动裁剪', async () => {
      // 添加 210 条经验
      for (let i = 0; i < 210; i++) {
        await repository.addExperience(
          createTestExperience({
            id: `exp-batch-${i}`,
            taskDescription: `任务 ${i}`,
          })
        );
      }
      await repository.loadAll();

      expect(await repository.getExperienceCount()).toBe(200);
    });
  });

  describe('loadAll / saveAll (持久化)', () => {
    it('空文件时 loadAll 应该保持空状态', async () => {
      await repository.loadAll();
      expect(await repository.getExperienceCount()).toBe(0);
    });

    it('saveAll 和 loadAll 应该保持数据一致性', async () => {
      const exp1 = createTestExperience({ id: 'exp-1', taskType: 'refactor' });
      const exp2 = createTestExperience({
        id: 'exp-2',
        taskType: 'feature',
        emotionalTone: 'frustrated',
      });

      await repository.addExperience(exp1);
      await repository.addExperience(exp2);
      await repository.saveAll();

      // 重新加载
      const newRepo = new JsonExperienceRepository(tempDir);
      await newRepo.loadAll();

      expect(await newRepo.getExperienceCount()).toBe(2);
    });

    it('文件损坏时 loadAll 应该优雅降级为空数组', async () => {
      // 写入损坏的 JSON
      const filePath = path.join(tempDir, 'experiences.json');
      await fs.mkdir(tempDir, { recursive: true });
      await fs.writeFile(filePath, 'not valid json {{{', 'utf-8');

      await repository.loadAll();
      expect(await repository.getExperienceCount()).toBe(0);
    });
  });

  describe('getAllExperiences', () => {
    it('应该返回所有经验', async () => {
      await repository.addExperience(createTestExperience({ id: 'exp-1' }));
      await repository.addExperience(createTestExperience({ id: 'exp-2' }));
      await repository.loadAll();

      const experiences = await repository.getAllExperiences();
      expect(experiences).toHaveLength(2);
    });
  });

  describe('getExperience', () => {
    it('应该通过 id 获取经验', async () => {
      const exp = createTestExperience({ id: 'exp-find' });
      await repository.addExperience(exp);
      await repository.loadAll();

      const found = await repository.getExperience('exp-find');
      expect(found).not.toBeNull();
      expect(found?.id).toBe('exp-find');
    });

    it('不存在的 id 应该返回 null', async () => {
      await repository.loadAll();
      const found = await repository.getExperience('nonexistent');
      expect(found).toBeNull();
    });
  });

  describe('generateBehaviorGuidelines', () => {
    it('没有经验时应该返回空字符串', async () => {
      const guidelines = await repository.generateBehaviorGuidelines();
      expect(guidelines).toBe('');
    });

    it('应该从失败教训中生成指导', async () => {
      await repository.addExperience(
        createTestExperience({
          id: 'exp-fail',
          emotionalTone: 'frustrated',
          lessons: [
            '❌ 改进方向: 修改配置文件前应该先备份',
            '❌ 改进方向: 使用 TypeScript 时优先使用 interface',
          ],
          improvements: ['建议改进: 处理API错误时总是检查rate limit'],
        })
      );
      await repository.loadAll();

      const guidelines = await repository.generateBehaviorGuidelines();
      expect(guidelines).toContain('修改配置文件前应该先备份');
      expect(guidelines).toContain('使用 TypeScript 时优先使用 interface');
    });
  });
});
