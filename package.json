{
  "name": "@personal-assistant/agent",
  "version": "2.0.0",
  "description": "Personal Assistant Agent CLI - AI-powered personal assistant with pipeline architecture",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "personal-assistant": "./dist/cli/index.js"
  },
  "scripts": {
    "install:all": "npm install && (cd frontend && npm install)",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "server": "tsx watch server/index.ts",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "word": "node scripts/word-cli.mjs",
    "fin": "node scripts/fin-cli.mjs",
    "lint": "eslint -c eslint.config.js src/**/*.ts",
    "lint:fix": "eslint -c eslint.config.js src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/**/integration/**' 'src/**/e2e/**'",
    "test:integration": "vitest run --include 'src/**/integration/**'",
    "test:e2e": "vitest run --include 'src/**/e2e/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify": "npm run lint && npm test && npm run build && (cd frontend && npm run build) && echo OK",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "ai",
    "cli",
    "agent",
    "personal-assistant",
    "llm",
    "chat",
    "pipeline",
    "rag",
    "agentic",
    "clean-architecture",
    "multi-provider",
    "knowledge-graph"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/badhope/Personal-Assistant"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "boxen": "^8.0.0",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "eventemitter3": "^5.0.4",
    "express": "^4.21.1",
    "glob": "^11.0.0",
    "graphology": "^0.25.4",
    "graphology-layout": "^0.6.1",
    "graphology-traversal": "^0.3.1",
    "graphology-utils": "^2.5.2",
    "keytar": "^7.9.0",
    "minisearch": "^7.2.0",
    "node-cron": "^4.2.1",
    "opossum": "^9.0.0",
    "ora": "^8.2.0",
    "p-queue": "^9.0.0",
    "p-retry": "^7.0.0",
    "picocolors": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "simple-git": "^3.36.0",
    "ts-morph": "^25.0.0",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.0",
    "wrap-ansi": "^10.0.0",
    "xstate": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/glob": "^9.0.0",
    "@types/node": "^22.19.19",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.0",
    "supertest": "^7.2.2",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
